{
  "name": "@kidoo/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "react-native": "./client.ts",
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./prisma": {
      "types": "./prisma/index.d.ts",
      "default": "./prisma/index.js"
    },
    "./prisma/*": {
      "types": "./prisma/*.d.ts",
      "default": "./prisma/*.js"
    },
    "./schemas/*": {
      "types": "./schemas/*.ts",
      "default": "./schemas/*.ts"
    },
    "./types/*": {
      "types": "./types/*.ts",
      "default": "./types/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:esp32-constants": "tsx scripts/generate-esp32-constants.ts"
  },
  "peerDependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "zod": "^4.3.5"
  }
}
